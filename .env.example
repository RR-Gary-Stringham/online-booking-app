# Canonical public URL of the mounted application. All application, embed, and
# Google OAuth callback URLs are derived from this value for portable deploys.
APP_URL="https://example.com/app"

# Server-only transactional email credentials.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="notifications@revrebel.io"
BREVO_SENDER_NAME="REVREBEL"
# Optional Brevo transactional template ID. When omitted, the app sends its
# built-in branded HTML confirmation instead.
BREVO_BOOKING_CONFIRMATION_TEMPLATE_ID=""

# Server-side Google OAuth configuration. Never expose these to browser code.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Register `${APP_URL}/api/auth/google/callback` as the authorized redirect URI
# in Google Cloud. The application derives it from APP_URL automatically.

# Encrypts stored OAuth credentials and signs management sessions.
TOKEN_ENCRYPTION_KEY=""
SESSION_SECRET=""

# Server-only Webflow CMS synchronization configuration.
BOOKING_CALENDAR_API_KEY=""
WEBFLOW_SITE_ID="6a09244ce43d4439301ce56f"
WEBFLOW_BOOKING_COLLECTION_ID="6a88cd437008cead90d60fd1"
